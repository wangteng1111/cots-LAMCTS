[Unit]
Description=COTS-LAMCTS GitHub Workstation Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cotslamcts
Group=cotslamcts
WorkingDirectory=/opt/cots-lamcts/infra
EnvironmentFile=/etc/cots-lamcts/bridge.env
Environment=COTS_BRIDGE_ROOT=/var/lib/cots-lamcts
ExecStart=/usr/bin/python3 /opt/cots-lamcts/infra/cots_workstation_bridge_v04.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cots-lamcts

[Install]
WantedBy=multi-user.target
